NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Phase 5: real Google OAuth (Gmail/Calendar). Absent in this sandbox — the
# Simulated connectors remain the fallback whenever these are unset. See
# README "Phase 5" section for scope rationale and setup.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 64 hex chars (32 bytes) — AES-256-GCM key for encrypting OAuth tokens at
# rest. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Service-role key, used ONLY by /api/cron/* scheduled-job routes and the
# public signed-file-download route (neither has a human tenant session to
# derive RLS context from) — see supabase/ER.md's background_jobs section
# and lib/supabase/serviceRole.ts.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# 64 hex chars (32 bytes) — HMAC key for signing short-lived file share
# links (spec §48). Generate with: openssl rand -hex 32
FILE_SIGNING_SECRET=
