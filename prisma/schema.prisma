generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TargetType {
  ALBAIT
  SPECIALIST
  GENERAL
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ChannelType {
  INDEED
  X
  INSTAGRAM
  LINE
  TIKTOK
  DIRECT
}

enum ApplicantStatus {
  NEW
  SCREENING
  PASSED
  REJECTED
  PENDING
  INTERVIEW_SCHEDULED
  HIRED
}

model Job {
  id            String     @id @default(cuid())
  title         String
  location      String
  salary        String
  conditions    String
  rawInput      String
  targetType    TargetType
  snsPostText   Json
  indeedText    String
  lineQuestions Json
  status        JobStatus  @default(DRAFT)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  applicants Applicant[]
  channels   Channel[]
  analytics  Analytics[]
}

model Channel {
  id          String      @id @default(cuid())
  jobId       String
  type        ChannelType
  content     String      @default("")
  publishedAt DateTime?
  createdAt   DateTime    @default(now())

  job        Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  analytics  Analytics[]
  applicants Applicant[]

  @@unique([jobId, type])
  @@index([jobId])
}

model Applicant {
  id                   String          @id @default(cuid())
  jobId                String
  channelId            String?
  lineUserId           String
  lineDisplayName      String?
  linePictureUrl       String?
  status               ApplicantStatus @default(NEW)
  step                 Int             @default(0)
  answers              Json?
  score                Int?
  evaluation           String?
  statusManual         Boolean         @default(false)
  interviewAt          DateTime?
  interviewConfirmedAt DateTime?
  notifiedAt           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@unique([jobId, lineUserId])
  @@index([channelId])
  @@index([lineUserId])
  @@index([jobId])
}

model Analytics {
  id          String   @id @default(cuid())
  jobId       String
  // Required: untracked traffic goes to the job's DIRECT channel, so the
  // unique key below is never defeated by NULL != NULL in Postgres.
  channelId   String
  date        DateTime @db.Date
  impressions Int      @default(0)
  applies     Int      @default(0)
  interviews  Int      @default(0)

  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([jobId, channelId, date])
  @@index([jobId])
}
